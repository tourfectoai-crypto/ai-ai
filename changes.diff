+                    (user_id, website_id, feature_key, bucket, subject_type, subject_id, mode_at_decision, status, title, context_text, draft_text, payload)
+                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
