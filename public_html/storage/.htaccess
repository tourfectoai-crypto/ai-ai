# ============================================
# Tourfecto - Cache .htaccess
# حماية مجلد الكاش من الوصول المباشر
# @version 1.0.0
# ============================================

# منع الوصول إلى جميع الملفات
Order Allow,Deny
Deny from all

# منع عرض محتويات المجلد
Options -Indexes

# إعادة توجيه جميع الطلبات
RewriteEngine On
RewriteRule ^.*$ - [F,L]

# إخفاء الملفات المخفية
RedirectMatch 404 /\..*$